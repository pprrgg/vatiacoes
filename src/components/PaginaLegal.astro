---
// Plantilla de las paginas legales (aviso legal, privacidad, condiciones)
import TopNav from './TopNav.astro';
import PieSitio from './PieSitio.astro';
import '../styles/sitio.css';
import { TITULAR } from '../data/titular';
interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} · VatiaCo</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
    <style is:global>
      .legal { max-width: 46rem; margin: 0 auto; padding: 3.5rem 1.25rem 4rem; }
      .legal h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0.6rem 0 0.4rem; }
      .legal .fecha { color: var(--gray-3); font-size: 0.9rem; margin: 0 0 2rem; }
      .legal h2 { font-size: 1.2rem; margin: 2.2rem 0 0.6rem; }
      .legal p, .legal li { font-size: 0.98rem; }
      .legal ul, .legal ol { padding-left: 1.3rem; }
      .legal li { margin-bottom: 0.35rem; }
      .legal a { color: var(--accent-high); }
      .legal strong { color: var(--gray-1); }
      .legal table { width: 100%; border-collapse: collapse; font-size: 0.92rem; margin: 0.6rem 0 1rem; }
      .legal th, .legal td { text-align: left; padding: 0.5rem 0.4rem; border-bottom: 1px solid var(--gray-5); vertical-align: top; }
      .legal th { color: var(--gray-3); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .legal .ficha { background: var(--gray-6); border: 1px solid var(--gray-5); border-radius: 0.75rem; padding: 1rem 1.2rem; }
      .legal .ficha p { margin: 0.2rem 0; }
      .legal .aviso-pruebas { border: 1px dashed rgba(255, 213, 79, 0.45); background: rgba(255, 213, 79, 0.05); margin: 0 0 1.5rem; }
      .legal .aviso-pruebas strong { color: var(--bolt); }
    </style>
  </head>
  <body>
    <TopNav />
    <main class="legal">
      <div class="etiqueta">Información legal</div>
      <h1>{titulo}</h1>
      <p class="fecha">Última actualización: {TITULAR.actualizado}</p>
      <slot />
    </main>
    <PieSitio />
  </body>
</html>
