---
// Barra de navegacion superior comun a toda la web (pagina principal y blog).
//   <TopNav />        pagina principal: el buscador lleva al blog (/blog/?q=texto)
//   <TopNav blog />   blog: el buscador filtra el indice lateral y el boton ☰ lo abre
// "Acceso socios" abre la plataforma en el visor comun (/js/plataforma.js), el
// mismo que el mapa de comunidades: el inicio de sesion es el mismo desde toda la web.
interface Props { blog?: boolean }
const { blog = false } = Astro.props;
const PORTAL_URL = 'https://VatiaCo.duckdns.org/';
const MAPA = '/comunidades/';
---
<header class="topnav">
  <div class="title-wrapper">
    <a class="site-title" href="/" aria-label="VatiaCo, página principal"><span class="brand-bolt" aria-hidden="true">⚡</span><span>VatiaCo</span></a>
  </div>
  <form class="header-search-group" action="/blog/" method="get" role="search" data-blog={blog ? '' : undefined}>
    <label class="search-trigger">
      <span class="sr-only">{blog ? 'Buscar en el índice' : 'Buscar en el blog'}</span>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z"/></svg>
      <input id="searchInput" name="q" type="search" placeholder={blog ? 'Buscar' : 'Buscar en el blog'} aria-keyshortcuts="Control+K" autocomplete="off" />
      <kbd><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
    </label>
  </form>
  <div class="right-group">
    <nav class="contact-links" aria-label="Principal">
      <a class="contact-link" href="/servicios/" aria-label="Servicios">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z"/></svg>
        <span class="contact-link-label">Servicios</span>
      </a>
      <a class="contact-link" href={MAPA} aria-label="Mapa de comunidades energéticas">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g stroke="#ffd54f"><circle cx="6" cy="6" r="2.4"/><path d="M6 1.2v1.1M6 9.7v1.1M1.2 6h1.1M9.7 6h1.1M2.6 2.6l.8.8M8.6 8.6l.8.8M2.6 9.4l.8-.8M8.6 3.4l.8-.8"/></g><path d="M9 12h13l-3 7H6l3-7Z"/><path d="M13.3 12l-3 7M17.7 12l-3 7M7.5 15.5h13"/><path d="M12.5 19v3M10 22h5"/></svg>
        <span class="contact-link-label">Comunidades</span>
      </a>
      <a class="contact-link" href="/blog/" aria-label="Blog">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14Z"/><path d="M8 7h8M8 11h6"/></svg>
        <span class="contact-link-label">Blog</span>
      </a>
      <a class="contact-link secundario" href="tel:+34951733491" aria-label="Llamar al 951 733 491">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V21a1 1 0 0 1-1 1C10.61 22 2 13.39 2 3a1 1 0 0 1 1-1h4.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.01l-2.21 2.21Z"/></svg>
        <span class="contact-link-label">951 733 491</span>
      </a>
      <a class="contact-link secundario" href="mailto:info@vatiaco.es" aria-label="Enviar un correo a info@vatiaco.es">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
        <span class="contact-link-label">info@vatiaco.es</span>
      </a>
    </nav>
    <a class="acceso" href={PORTAL_URL} data-plataforma="Acceso socios" aria-label="Acceso socios">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
      <span class="acceso-label">Acceso socios</span>
    </a>
    {blog && (
      <button id="menuToggleButton" class="burger" type="button" aria-label="Abrir el índice" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    )}
  </div>
</header>

<script is:inline src="/js/plataforma.js"></script>
<script is:inline>
  (function () {
    var form = document.querySelector('.topnav form[role=search]');
    var input = document.getElementById('searchInput');
    // En el blog el buscador filtra el indice lateral (lo gestiona la pagina): sin envio
    if (form && form.hasAttribute('data-blog')) form.addEventListener('submit', function (e) { e.preventDefault(); });
    // Ctrl+K: al buscador (el blog tiene su propio atajo)
    else document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input.focus(); input.select(); }
    });
  })();
</script>

<style is:global>
      .topnav *, .topnav *::before, .topnav *::after { box-sizing: border-box; }
      .topnav {
        --tn-accent: #3369ff; --tn-white: #ffffff; --tn-gray-2: #c1c3c8; --tn-gray-3: #888c96;
        --tn-gray-5: #353841; --tn-gray-6: #23262f; --tn-black: #17181c;
      }
      .topnav .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .topnav {
        position: sticky; top: 0; z-index: 50; box-sizing: border-box;
        display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
        height: var(--nav-height, 3.5rem); padding: 0 1rem;
        background: var(--tn-gray-6); border-bottom: 1px solid var(--tn-black);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial, sans-serif;
      }
      @media (min-width: 800px) { .topnav { padding: 0 1.5rem; } }
      .title-wrapper { min-width: 0; overflow: hidden; }
      .site-title { display: inline-flex; align-items: center; font-size: 1.15rem; font-weight: 700; text-decoration: none; white-space: nowrap; color: var(--tn-white); }
      .site-title .brand-bolt { margin-right: 0.4rem; font-size: 1.25em; line-height: 1; }
      .header-search-group { min-width: 0; display: flex; justify-content: center; margin: 0; }
      .search-trigger {
        display: flex; align-items: center; gap: 0.5rem; height: 2.5rem; width: 100%; max-width: 22rem;
        padding-inline: 0.75rem 0.5rem; border-radius: 0.5rem; border: 1px solid var(--tn-gray-5);
        background: var(--tn-black); color: var(--tn-gray-2);
      }
      .search-trigger:focus-within { border-color: var(--tn-accent); }
      .search-trigger svg { flex-shrink: 0; }
      .search-trigger input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--tn-white); font: inherit; font-size: 0.875rem; }
      .search-trigger input:focus { outline: none; }
      .search-trigger input::placeholder { color: var(--tn-gray-3); }
      .search-trigger kbd { display: inline-flex; gap: 0.25em; flex-shrink: 0; }
      .search-trigger kbd kbd { font-family: inherit; font-size: 0.7rem; background: var(--tn-gray-6); border-radius: 0.25rem; padding-inline: 0.375rem; padding-block: 0.1rem; }
      @media (max-width: 799px) { .search-trigger kbd { display: none; } }
      .right-group { display: flex; align-items: center; gap: 1rem; min-width: 0; }
      .contact-links { display: flex; align-items: center; gap: 1rem; min-width: 0; }
      .contact-link { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--tn-gray-2); font-size: 0.875rem; text-decoration: none; white-space: nowrap; }
      .contact-link:hover, .contact-link:focus-visible { color: var(--tn-white); outline: none; }
      .contact-link svg { flex-shrink: 0; }
      /* telefono y correo: solo icono cuando no cabe todo */
      @media (max-width: 1400px) { .contact-link.secundario .contact-link-label { display: none; } }
      @media (max-width: 620px) {
        .contact-links { gap: 0.5rem; }
        .contact-link { width: 2rem; height: 2rem; justify-content: center; border-radius: 0.375rem; }
        .contact-link:hover, .contact-link:focus-visible { background: var(--tn-gray-5); }
        .contact-link .contact-link-label { display: none; }
      }
      /* Acceso socios: mismo visor e inicio de sesion que el mapa de comunidades */
      .acceso {
        display: inline-flex; align-items: center; gap: 0.45rem; height: 2.5rem; padding: 0 0.95rem; border-radius: 0.5rem;
        background: var(--tn-accent); color: var(--tn-white); font-size: 0.875rem; font-weight: 600; text-decoration: none; white-space: nowrap;
      }
      .acceso:hover, .acceso:focus-visible { background: #4a7bff; outline: none; }
      @media (max-width: 860px) { .acceso { width: 2.5rem; padding: 0; justify-content: center; } .acceso .acceso-label { display: none; } }

      /* movil: el buscador es un boton con lupa que, al pulsarlo, ocupa toda la barra */
      @media (max-width: 480px) {
        .header-search-group { justify-content: flex-end; }
        .topnav { gap: 0.5rem; padding: 0 0.6rem; }
        .right-group, .contact-links { gap: 0.25rem; }
        .search-trigger { width: 2.5rem; padding: 0; justify-content: center; cursor: pointer; }
        .search-trigger input { flex: 0 0 0; width: 0; padding: 0; }
        .search-trigger:focus-within { position: absolute; left: 0.75rem; right: 0.75rem; top: calc((var(--nav-height, 3.5rem) - 2.5rem) / 2);
          width: auto; max-width: none; padding-inline: 0.75rem 0.5rem; justify-content: flex-start; z-index: 2; }
        .search-trigger:focus-within input { flex: 1 1 auto; width: auto; }
      }
      /* boton del indice lateral (solo en el blog, pantallas estrechas) */
      .burger { display: none; align-items: center; justify-content: center; border: none; background: var(--tn-gray-5);
        color: var(--tn-gray-2); width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; cursor: pointer; flex: none; }
      @media (max-width: 980px) { .burger { display: inline-flex; } }
</style>
