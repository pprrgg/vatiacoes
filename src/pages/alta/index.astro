---
import TopNav from '../../components/TopNav.astro';
import PieSitio from '../../components/PieSitio.astro';
import DemoAcceso from '../../components/DemoAcceso.astro';
import '../../styles/sitio.css';
// Alta online de una comunidad energetica, gratuita: formulario y nada mas. La API de la
// plataforma (iot-thingsboard.sh, app/alta.py) valida los datos como el panel del superusuario
// y crea la comunidad (tenant, base de datos, paneles y usuario del gestor con la contraseña
// elegida aqui); /alta/gracias/ espera a que este lista.
const API = 'https://VatiaCo.duckdns.org/cec-api';
// La comunidad se elige entre las del IDAE (las mismas del mapa, src/data/comunidades-idae.json):
// sus datos salen de alli y la API los vuelve a comprobar. Del formulario se registra el gestor.
import IDAE from '../../data/comunidades-idae.json';
const { actualizado: ACTUALIZADO, fuente: FUENTE } = IDAE;
const vistos = new Set<string>();
const lista = IDAE.comunidades
  .filter((c) => { const k = c.n + '|' + c.m; return !vistos.has(k) && vistos.add(k); })
  .map((c) => ({ n: c.n, m: c.m, p: c.p, a: c.a, s: c.s, w: c.w, etiqueta: `${c.n.trim()} — ${c.m} (${c.p})` }))
  .sort((x, y) => x.etiqueta.localeCompare(y.etiqueta, 'es'));
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alta de comunidad · VatiaCo</title>
    <meta name="description" content="Da de alta tu comunidad energética en la plataforma VatiaCo. Uso gratuito, sin cuotas ni datos bancarios." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
    <style is:global>
      .alta-rejilla { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 1.5rem; align-items: start; }
      @media (max-width: 900px) { .alta-rejilla { grid-template-columns: 1fr; } .alta-resumen { position: static !important; order: -1; } }
      .alta-caja { background: var(--gray-6); border: 1px solid var(--gray-5); border-radius: 0.9rem; padding: 1.5rem; }
      .alta-form fieldset { border: 0; padding: 0; margin: 0 0 1.6rem; }
      .alta-form legend { color: var(--white); font-weight: 700; font-size: 1.1rem; margin-bottom: 0.9rem; padding: 0; }
      .campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1rem; }
      .campos .ancho { grid-column: 1 / -1; }
      @media (max-width: 560px) { .campos { grid-template-columns: 1fr; } }
      .campo label, .campo .lbl { display: block; font-size: 0.85rem; font-weight: 600; color: var(--gray-1); margin-bottom: 0.35rem; }
      .campo .opc { font-weight: 400; color: var(--gray-3); }
      .campo input, .campo select { width: 100%; padding: 0.65rem 0.8rem; font: inherit; color: var(--white); background: var(--black);
        border: 1px solid var(--gray-5); border-radius: 0.5rem; }
      .campo input:focus, .campo select:focus { outline: none; border-color: var(--accent); }
      .campo .ayuda { font-size: 0.8rem; color: var(--gray-3); margin-top: 0.3rem; }
      .campo .err { display: none; font-size: 0.8rem; color: #ff8a80; margin-top: 0.3rem; }
      .campo.mal input, .campo.mal select { border-color: #ff8a80; }
      .campo.mal .err { display: block; }
      .campo .ayuda a { color: var(--accent-high); }
      .ficha { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem 1rem; margin: 1rem 0 0; padding: 1rem 1.1rem;
        border-radius: 0.6rem; background: var(--black); border: 1px solid var(--gray-5); }
      .ficha .ancho { grid-column: 1 / -1; }
      .ficha dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-3); }
      .ficha dd { margin: 0.1rem 0 0; color: var(--white); font-weight: 600; overflow-wrap: anywhere; }
      .ficha a { color: var(--accent-high); font-weight: 500; }
      .fuente { margin: 0.8rem 0 0; font-size: 0.78rem; color: var(--gray-3); }
      .fuente a { color: var(--gray-2); }
      .acepto { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.92rem; }
      .acepto input { width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; accent-color: var(--accent); flex: none; }
      .acepto a { color: var(--accent-high); }
      .alta-form .btn.principal { width: 100%; justify-content: center; margin-top: 1.2rem; padding: 0.9rem; font-size: 1rem; cursor: pointer; }
      .alta-form .btn:disabled { opacity: 0.5; cursor: not-allowed; }
      .nota { text-align: center; font-size: 0.8rem; color: var(--gray-3); margin: 0.6rem 0 0; }
      .aviso { padding: 0.75rem 1rem; border-radius: 0.5rem; margin: 0 0 1.2rem; font-size: 0.92rem; }
      .aviso.mal { background: #3a1d1b; color: #ffb4ab; }
      .aviso.info { background: var(--accent-low); color: var(--gray-1); }
      [hidden] { display: none !important; }
      .alta-resumen { position: sticky; top: calc(var(--nav-height) + 1rem); }
      .alta-resumen h3 { margin: 0; font-size: 0.95rem; color: var(--gray-3); font-weight: 600; }
      .cifra { font-size: 2.6rem; font-weight: 800; color: var(--white); line-height: 1.15; letter-spacing: -0.02em; }
      .alta-resumen ul { margin: 0.8rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.4rem; font-size: 0.88rem; }
      .alta-resumen li { padding-left: 1.3rem; position: relative; }
      .alta-resumen li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-high); font-weight: 700; }
      .letra { margin: 1rem 0 0; padding: 0.8rem; border-radius: 0.5rem; background: rgba(255, 213, 79, 0.08); font-size: 0.8rem; color: var(--gray-2); }
    </style>
  </head>
  <body>
    <TopNav />

    <main>
      <div class="hero">
        <div class="wrap">
          <div class="etiqueta">Alta de comunidad</div>
          <h1>Plataforma <em>de uso gratuito</em>.</h1>
          <p>Rellena los datos y la plataforma de tu comunidad se crea al momento: paneles, base de datos y tu usuario de gestor para
            dar de alta a los socios. Sin cuotas, sin permanencia y sin datos bancarios.</p>
        </div>
      </div>

      <section style="padding-top: 2.5rem;">
        <div class="wrap">
          <div class="aviso mal" id="inactiva" hidden>El alta online no está disponible ahora mismo. Inténtalo más tarde o escríbenos a
            <a href="mailto:info@vatiaco.es?subject=Alta%20de%20comunidad">info@vatiaco.es</a>.</div>
          <DemoAcceso />
         <div class="alta-rejilla">
            <form class="alta-caja alta-form" id="formulario" novalidate>
              <fieldset>
                <legend>La comunidad</legend>
                <div class="campos">
                  <div class="campo ancho" data-campo="comunidad">
                    <label for="comunidad">Comunidad energética</label>
                    <input id="comunidad" list="lista-idae" autocomplete="off" spellcheck="false" placeholder="Escribe su nombre o su municipio…" />
                    <datalist id="lista-idae">{lista.map((c) => <option value={c.etiqueta} />)}</datalist>
                    <div class="ayuda">Elige tu comunidad entre las registradas en el IDAE, las del <a href="/comunidades/">mapa</a>.
                      ¿No aparece? <a href="mailto:info@vatiaco.es?subject=Alta%20de%20comunidad">Escríbenos</a>.</div>
                    <div class="err"></div>
                  </div>
                </div>
                <dl class="ficha" id="ficha" hidden>
                  <div><dt>Municipio</dt><dd id="f-municipio"></dd></div>
                  <div><dt>Provincia</dt><dd id="f-provincia"></dd></div>
                  <div><dt>Comunidad autónoma</dt><dd id="f-autonomia"></dd></div>
                  <div><dt>Socios</dt><dd id="f-socios"></dd></div>
                  <div class="ancho" id="f-web-c" hidden><dt>Web</dt><dd><a id="f-web" target="_blank" rel="noopener"></a></dd></div>
                </dl>
                <p class="fuente">Datos de la comunidad: <a href={FUENTE.url} target="_blank" rel="noopener">{FUENTE.nombre}</a>,
                  actualizados el {ACTUALIZADO}. Si alguno no es correcto, escríbenos y lo corregimos.</p>
              </fieldset>

              <fieldset>
                <legend>Gestor de la comunidad</legend>
                <div class="campos">
                  <div class="campo ancho" data-campo="contacto">
                    <label for="contacto">Nombre y apellidos</label>
                    <input id="contacto" name="contacto" maxlength="80" autocomplete="name" />
                    <div class="err"></div>
                  </div>
                  <div class="campo" data-campo="email">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" maxlength="120" autocomplete="email" />
                    <div class="ayuda">Es tu usuario para entrar en la plataforma.</div>
                    <div class="err"></div>
                  </div>
                  <div class="campo" data-campo="telefono">
                    <label for="telefono">Teléfono <span class="opc">(opcional)</span></label>
                    <input id="telefono" name="telefono" type="tel" maxlength="20" autocomplete="tel" />
                    <div class="err"></div>
                  </div>
                  <div class="campo" data-campo="password">
                    <label for="password">Contraseña</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" />
                    <div class="ayuda">Al menos 8 caracteres.</div>
                    <div class="err"></div>
                  </div>
                  <div class="campo" data-campo="password2">
                    <label for="password2">Repite la contraseña</label>
                    <input id="password2" name="password2" type="password" autocomplete="new-password" />
                    <div class="err"></div>
                  </div>
                </div>
              </fieldset>


              <div class="campo" data-campo="acepta">
                <label class="acepto"><input type="checkbox" id="acepta" name="acepta" />
                  <span>Acepto las <a id="url-condiciones" href="/condiciones/" target="_blank" rel="noopener">condiciones de uso</a> y la
                    <a id="url-privacidad" href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>, y que el uso
                    de la plataforma es gratuito y queda bajo mi responsabilidad como gestor de la comunidad.</span></label>
                <div class="err"></div>
              </div>

              <div class="aviso mal" id="error-general" hidden style="margin-top: 1rem;"></div>
              <button class="btn principal" type="submit" id="enviar">Crear la plataforma de la comunidad</button>
              <p class="nota">Gratis. No se piden datos bancarios.</p>
            </form>

            <aside class="alta-caja alta-resumen">
              <h3>Uso de la plataforma</h3>
              <div class="cifra">Gratis</div>
              <ul>
                <li>Sin cuotas ni límite de socios</li>
                <li>Todas las funciones incluidas</li>
                <li>Sin permanencia: baja con un email</li>
                <li>Panel para cada socio y para el gestor</li>
              </ul>
              <p class="letra">La plataforma se ofrece tal cual, sin garantías. Su uso, los datos que se introducen y las decisiones
                que se tomen con ella son responsabilidad del gestor de la comunidad.</p>
            </aside>
          </div>
        </div>
      </section>
    </main>

    <PieSitio />

    <script is:inline define:vars={{ API, LISTA: lista }}>
      (function () {
        var $ = function (s) { return document.querySelector(s); };
        var form = $('#formulario'), BORRADOR = 'alta-comunidad-borrador';
        var CAMPOS = ['contacto', 'email', 'telefono'];
        var inCom = $('#comunidad'), elegida = null;
        var POR_ETIQUETA = {}; LISTA.forEach(function (c) { POR_ETIQUETA[c.etiqueta] = c; });

        // Comunidad elegida de la lista del IDAE: su ficha
        function elegir() {
          var c = POR_ETIQUETA[inCom.value] || null;
          elegida = c;
          $('#ficha').hidden = !c;
          if (!c) return;
          $('#f-municipio').textContent = c.m; $('#f-provincia').textContent = c.p;
          $('#f-autonomia').textContent = c.a || '–'; $('#f-socios').textContent = c.s ? c.s.toLocaleString('es-ES') : 'sin datos';
          $('#f-web-c').hidden = !c.w;
          if (c.w) { $('#f-web').href = c.w; $('#f-web').textContent = c.w.replace(/^https?:\/\//, ''); }
          limpiar('comunidad');
        }
        inCom.addEventListener('input', function () { elegir(); guardar(); });

        function guardar() {
          var d = {}; CAMPOS.forEach(function (k) { d[k] = form[k].value; }); d.comunidad = inCom.value;
          try { sessionStorage.setItem(BORRADOR, JSON.stringify(d)); } catch (e) {}
        }
        function restaurar() {
          var d = null; try { d = JSON.parse(sessionStorage.getItem(BORRADOR) || 'null'); } catch (e) {}
          if (!d) return;
          Object.keys(d).forEach(function (k) {
            if (k === 'comunidad') { inCom.value = d[k]; elegir(); }
            else if (form[k]) form[k].value = d[k];
          });
        }
        function limpiar(c) { var e = document.querySelector('[data-campo="' + c + '"]'); if (e) e.classList.remove('mal'); }
        function errores(es) {
          var primero = null;
          Object.keys(es).forEach(function (c) {
            var e = document.querySelector('[data-campo="' + c + '"]');
            if (!e) { general(es[c]); return; }
            e.classList.add('mal'); e.querySelector('.err').textContent = es[c]; primero = primero || e;
          });
          if (primero) { primero.scrollIntoView({ behavior: 'smooth', block: 'center' });
            var i = primero.querySelector('input, select'); if (i) i.focus({ preventScroll: true }); }
        }
        function general(t) { var e = $('#error-general'); e.textContent = t; e.hidden = false; }

        restaurar();
        fetch(API + '/alta/info').then(function (r) { return r.json(); }).then(function (t) {
          if (t.url_condiciones) $('#url-condiciones').href = t.url_condiciones;
          if (t.url_privacidad) $('#url-privacidad').href = t.url_privacidad;
          $('#inactiva').hidden = t.activa;
          $('#enviar').disabled = !t.activa;
        }).catch(function () { $('#inactiva').hidden = false; $('#enviar').disabled = true; });

        form.addEventListener('input', function (e) { if (e.target.name) limpiar(e.target.name); guardar(); });

        var TEXTO = 'Crear la plataforma de la comunidad';
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          $('#error-general').hidden = true;
          if (!elegida) { errores({ comunidad: 'Elige tu comunidad de la lista (comunidades registradas en el IDAE).' }); return; }
          var d = {}; CAMPOS.concat(['password', 'password2']).forEach(function (k) { d[k] = form[k].value; });
          d.idae = { n: elegida.n, m: elegida.m };
          d.acepta = form.acepta.checked;
          var b = $('#enviar'); b.disabled = true; b.textContent = 'Enviando…';
          fetch(API + '/alta/solicitud', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
            .then(function (r) { return r.json().catch(function () { return {}; }).then(function (c) { return { ok: r.ok, c: c }; }); })
            .then(function (x) {
              if (x.ok && x.c.alta) { location.href = '/alta/gracias/?alta=' + encodeURIComponent(x.c.alta); return; }
              if (x.c.errores) errores(x.c.errores);
              else general(x.c.detail || 'No se ha podido hacer el alta. Inténtalo de nuevo.');
              b.disabled = false; b.textContent = TEXTO;
            })
            .catch(function () {
              general('No hay conexión con la plataforma. Inténtalo de nuevo en unos minutos.');
              b.disabled = false; b.textContent = TEXTO;
            });
        });
      })();
    </script>
  </body>
</html>
