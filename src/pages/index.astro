---
import TopNav from '../components/TopNav.astro';
import PieSitio from '../components/PieSitio.astro';
import { getDocsTree, type DocNode } from '../data/docs';
import '../styles/sitio.css';
// Pagina principal de VatiaCo: la plataforma para comunidades energeticas, la comunidad de
// prueba y el blog interactivo.
// El blog (visor de public/docs) esta en /blog/; los enlaces antiguos /?doc=... se
// reenvian alli (script del <head>) para no romper QR ni enlaces compartidos.
// Plataforma: los enlaces con data-plataforma la abren en el visor comun (/js/plataforma.js,
// cargado por TopNav); con data-plataforma-ruta="login?alta=prueba" se abre directamente el
// alta de la comunidad de prueba (config/branding/VatiaCo-alta.js de iot-thingsboard.sh).
const PORTAL_URL = 'https://VatiaCo.duckdns.org/';
// Rutas del modal «Alta de una comunidad energética» de la plataforma: abierto en la pestaña
// «De la lista del IDAE» o en «Comunidad de prueba»
const ALTA_RUTA = 'login?alta=comunidad';
const PRUEBA_RUTA = 'login?alta=prueba';
// Vida de la comunidad de prueba: la de ALTA_PRUEBA_MINUTOS (iot-thingsboard.sh); si cambia alli, aqui tambien
const PRUEBA_VIDA = '1 hora';
const doc = (url: string) => `/blog/?doc=${encodeURIComponent(url)}`;
const CE = '/docs/A00_Blog_Interactivo/A02_Comunidades Energéticas/';

// Blog interactivo: una tarjeta por seccion (carpetas de public/docs/A00_Blog_Interactivo),
// con el numero de herramientas y las primeras; el texto y el icono de cada una van aqui
const SECCIONES: Record<string, { t: string; d: string; ico: string; top: [string, string][] }> = {
  'A01_FV': { t: 'Fotovoltaica', ico: 'sol', d: 'Diseño, generación, baterías, tramitación y presupuesto de una instalación fotovoltaica.',
    top: [['C02_Generación_Fotovoltaica.html', 'Generación horaria con PVGIS y LCOE'], ['C04_Autoconsumo_FV_con_bateria.html', 'Autoconsumo con batería'], ['C04_Presupuesto_fotovoltaico_detallado.html', 'Presupuesto detallado']] },
  'A02_Comunidades Energéticas': { t: 'Comunidades energéticas', ico: 'comunidad', d: 'Constitución, documentos, coeficientes de reparto y datos de Datadis.',
    top: [['C01_Comunidades_Energeticas.html', 'Cómo constituir la comunidad'], ['C01_Documentos_CEC.html', 'Generador de documentos'], ['C04_Coeficientes_de_Reparto.html', 'Coeficientes de reparto']] },
  'A02_Contrato_de_electricidad': { t: 'Contrato de electricidad', ico: 'factura', d: 'Factura eléctrica, peajes y optimización de la potencia contratada.',
    top: [['B01_Hasta_50_kW/C01_Facturacion_Electrica_Completa.html', 'Factura eléctrica completa'], ['B01_Hasta_50_kW/C02_Optimizacion_Potencia.html', 'Optimización de la potencia'], ['C06_Peajes_Circular_3_2020.html', 'Peajes (Circular 3/2020)']] },
  'A05_Vehiculo_Electrico': { t: 'Vehículo eléctrico', ico: 'coche', d: 'Qué vehículo te conviene, comparativa, funcionamiento y recarga según la ITC-BT-52.',
    top: [['C01_Que_Vehiculo_Me_Conviene.html', '¿Qué vehículo me conviene?'], ['C02_Comparativa_Coches_Electricos.html', 'Comparativa de coches eléctricos'], ['C03_ INFRAESTRUCTURA PARA LA RECARGA DE VEHÍCULOS ELÉCTRICOS_Guia_BT_52.html', 'Infraestructura de recarga (ITC-BT-52)']] },
  'A06_Auditoria_Energetica': { t: 'Auditoría energética', ico: 'lupa', d: 'Auditoría energética según la ISO 50002, con su informe.',
    top: [['C01_Auditoria_Energetica.html', 'Auditoría energética ISO 50002']] },
  'A07_Rehabilitacion_Energetica': { t: 'Rehabilitación energética', ico: 'casa', d: 'Simulador del comportamiento energético de edificios en España.',
    top: [['C01_Simulador_Edificios_Espana.html', 'Simulador de rehabilitación de edificios']] },
  'A08_Energia_Eolica': { t: 'Energía eólica', ico: 'viento', d: 'Estudio del recurso eólico de un emplazamiento en España.',
    top: [['C01_Estudio_Recurso_Eolico.html', 'Estudio del recurso eólico']] },
  'A08_Instalaciones': { t: 'Instalaciones eléctricas', ico: 'cable', d: 'Sección de conductores en baja tensión y baterías de condensadores.',
    top: [['C01_Sección de conductores en BT.html', 'Sección de conductores en BT'], ['B02_Dimensionado de baterías de condensadores.html', 'Baterías de condensadores']] },
  'A09_CAEs': { t: 'Certificados de Ahorro Energético', ico: 'cae', d: 'Fichas CAE del sector agrario, industrial, residencial, terciario y transporte.',
    top: [['B03_Residencial/C02_CAE_Sustitucion_Caldera_BDC.html', 'Caldera por bomba de calor'], ['B02_Industrial/C04_CAE_Variador_De_Velocidad.html', 'Variador de velocidad'], ['B05_Transporte/C01_CAE_Vehiculo_Electrico.html', 'Vehículo eléctrico']] },
  'ERP': { t: 'Herramientas de oficina', ico: 'erp', d: 'Documentos PDF con calidad LaTeX e inventario de materiales.',
    top: [['A01_Crear documentos PDF con calidad Latex.html', 'Documentos PDF con calidad LaTeX'], ['A03_Inventario.html', 'Inventario de materiales']] },
};
const ICONOS: Record<string, string> = {
  sol: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  comunidad: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 5a3 3 0 0 1 0 6M18 14.5c1.8.8 3 2.7 3 4.9"/>',
  factura: '<path d="M6 2h9l4 4v16l-2.5-1.5L14 22l-2-1.5L10 22l-2.5-1.5L5 22V3a1 1 0 0 1 1-1Z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  coche: '<path d="M5 17h14v-4l-2-5H7l-2 5v4Z"/><circle cx="8" cy="17" r="1.6"/><circle cx="16" cy="17" r="1.6"/><path d="m12.5 9.5-1.5 2.5h2l-1.5 2.5"/>',
  lupa: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M8 11h6M11 8v6"/>',
  casa: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  viento: '<path d="M3 8h11a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h7"/>',
  cable: '<path d="M7 3v5a5 5 0 0 0 10 0V3M10 3v3M14 3v3M12 13v8"/>',
  cae: '<circle cx="12" cy="9" r="6"/><path d="m9 14-1.5 8L12 20l4.5 2L15 14"/><path d="m10 9 1.5 1.5L14.5 7.5"/>',
  erp: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v16"/>',
};
const archivos = (n: DocNode): Extract<DocNode, { type: 'file' }>[] =>
  n.type === 'file' ? [n] : n.children.flatMap(archivos);
const raiz = (await getDocsTree()).find((n) => n.type === 'folder' && n.name === 'A00_Blog_Interactivo');
const blog = raiz && raiz.type === 'folder'
  ? raiz.children.filter((n) => n.type === 'folder' && SECCIONES[n.name]).map((n) => {
      const s = SECCIONES[n.name], fs = archivos(n), base = `/docs/A00_Blog_Interactivo/${n.name}/`;
      const urls = new Set(fs.map((f) => f.url));
      // los destacados que existen (si se renombra un documento, deja de salir en lugar de romperse)
      const primeros = s.top.map(([f, t]) => ({ url: base + f, title: t })).filter((f) => urls.has(f.url));
      return { ...s, n: fs.length, primeros, url: doc((primeros[0] || fs[0]).url) };
    })
  : [];
const herramientas = blog.reduce((s, b) => s + b.n, 0);

// Apps destacadas bajo los botones principales: para añadir una, otra entrada aqui y su
// captura (1280x745) en public/img/apps/. Si se renombra un documento, deja de salir.
const FV = '/docs/A00_Blog_Interactivo/A01_FV/';
const APPS = [
  { t: 'Diseña tu instalación fotovoltaica', d: 'Pinta los paneles sobre el mapa satélite de tu tejado.', url: FV + 'C01_Diseno_Sistemas_FV.html', img: '/img/apps/diseno-sistemas-fv.jpg' },
  { t: 'Dimensiona tu batería', d: 'Simula hora a hora el flujo entre paneles, batería, red y consumo.', url: FV + 'C02_Dimensiona_la_bateria_FV.html', img: '/img/apps/dimensiona-bateria-fv.jpg' },
  { t: 'Coeficientes de reparto', d: 'Reparte la energía entre los socios y genera el fichero para la distribuidora.', url: CE + 'C04_Coeficientes_de_Reparto.html', img: '/img/apps/coeficientes-reparto.jpg' },
];
const urlsBlog = new Set(raiz ? archivos(raiz).map((f) => f.url) : []);
const apps = APPS.filter((a) => urlsBlog.has(a.url));

const plataforma = [
  { t: 'Socios e instalaciones', d: 'Alta de cada socio con su usuario, sus puntos de medida e instalaciones (fotovoltaica, eólica, batería, recarga) en un mapa.' },
  { t: 'Reparto de la energía', d: 'Generación, consumo y neto de cada socio hora a hora: la base para fijar y revisar los coeficientes de reparto.' },
  { t: 'Seguimiento y ahorro', d: 'Energía compartida, intercambio con la red y ahorro estimado de la comunidad, por días y por horas.' },
  { t: 'Portal de cada socio', d: 'Cada socio ve solo sus datos, en el ordenador o en el móvil, y descarga su panel en PDF.' },
];
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VatiaCo · Plataforma para comunidades energéticas</title>
    <meta name="description" content="Crea y gestiona tu comunidad energética: socios, reparto de la energía y seguimiento hora a hora. Prueba gratis con una comunidad de prueba y usa las herramientas del blog interactivo." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Enlaces antiguos al blog (/?doc=...): al blog, con el mismo documento
      if (new URLSearchParams(location.search).has('doc')) location.replace('/blog/' + location.search + location.hash);
    </script>
    <style>
      /* Tema claro y sobrio (colores en src/styles/sitio.css): blanco, gris muy suave para
         alternar secciones, un azul de accion y el amarillo del sol solo en la prueba */
      .ini-hero { padding: 5rem 0 4.5rem; background: linear-gradient(180deg, #f5f8fd 0%, #fff 100%); }
      @media (max-width: 920px) { .ini-hero { padding: 3rem 0 3.5rem; } }
      /* cabecera centrada (sin el cuadro de la derecha) */
      .ini-hero .wrap { text-align: center; }
      .ini-hero h1 { margin: 0.9rem auto 1.1rem; max-width: 56rem; text-wrap: balance; }
      .ini-hero .grandes { justify-content: center; }
      .ini-hero .gran { text-align: left; }
      /* «gratuita» resaltada: pastilla amarilla (el color del sol) */
      .gratis { display: inline-block; padding: 0.22rem 0.7rem; margin: 0 0.15rem; border-radius: 999px; background: var(--sol);
        color: var(--white); font-weight: 800; letter-spacing: 0.1em; box-shadow: 0 2px 8px rgba(255, 184, 0, 0.3); }
      .gratis-f { color: #fff; background: rgba(255, 255, 255, 0.16); padding: 0.05rem 0.45rem; border-radius: 0.35rem; }
      .ini-hero .lead { font-size: 1.15rem; max-width: 38rem; margin: 0 auto 2rem; color: var(--gray-2); }

      /* los dos botones principales: alta (lista del IDAE) y comunidad de prueba */
      .grandes { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .gran { display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1.5rem 0.9rem 1.15rem;
        border-radius: 999px; text-decoration: none; transition: background 0.15s, box-shadow 0.15s, transform 0.15s; }
      .gran span { display: flex; flex-direction: column; line-height: 1.25; }
      .gran b { font-size: 1.05rem; }
      .gran small { font-size: 0.8rem; font-weight: 500; opacity: 0.85; }
      .gran svg { flex: none; }
      .gran:hover { transform: translateY(-1px); }
      .gran.alta { background: var(--accent); color: #fff; box-shadow: 0 6px 18px rgba(36, 87, 230, 0.25); }
      .gran.alta:hover { background: var(--accent-hover); }
      .gran.prueba-b { background: var(--sol); color: var(--white); box-shadow: 0 6px 18px rgba(255, 184, 0, 0.25); }
      .gran.prueba-b:hover { background: var(--sol-hover); }
      @media (max-width: 560px) { .grandes { flex-direction: column; } .gran { width: 100%; min-width: 0; } }
      .btn.amarillo { background: var(--sol); border-color: var(--sol); color: var(--white); }
      .btn.amarillo:hover { background: var(--sol-hover); border-color: var(--sol-hover); color: var(--white); }

      /* apps destacadas: captura de cada herramienta del blog */
      .apps { margin-top: -1.5rem; position: relative; }
      .btn.relleno { display: inline-flex; align-items: center; gap: 0.55rem; background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn.relleno span { display: flex; flex-direction: column; line-height: 1.25; text-align: left; }
      .btn.relleno small { font-size: 0.78rem; font-weight: 500; opacity: 0.85; }
      .btn.relleno:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }
      .apps-tit { text-align: center; margin-bottom: 1.8rem; }
      .apps-tit h2 { margin: 0.9rem auto 0; text-wrap: balance; }
      .apps ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr)); gap: 1.1rem; }
      .app { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid var(--gray-5); border-radius: 1rem;
        overflow: hidden; box-shadow: var(--sombra); text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
      .app:hover, .app:focus-visible { border-color: var(--accent); transform: translateY(-2px); }
      .app img { display: block; width: 100%; height: auto; aspect-ratio: 1280 / 745; object-fit: cover; object-position: top; border-bottom: 1px solid var(--gray-5); }
      .app div { padding: 1rem 1.2rem 1.15rem; }
      .app b { display: block; color: var(--white); font-size: 1rem; line-height: 1.3; margin-bottom: 0.25rem; }
      .app span { font-size: 0.86rem; color: var(--gray-3); line-height: 1.4; }
      .app:hover b { color: var(--accent); }

      .cabecera { display: flex; justify-content: space-between; align-items: end; gap: 1rem 2rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
      .cabecera .intro { margin: 0; }

      /* plataforma: banda gris suave */
      #plataforma { background: var(--gray-6); margin-top: 4rem; }
      .plat { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
      @media (max-width: 960px) { .plat { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 560px) { .plat { grid-template-columns: 1fr; } }
      .plat div { background: #fff; padding: 1.6rem 1.4rem; border-radius: 1rem; }
      .plat .n { display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--accent-low);
        font-size: 0.8rem; font-weight: 700; color: var(--accent); }
      .plat h3 { margin: 0.9rem 0 0.45rem; font-size: 1.08rem; }
      .plat p { margin: 0; font-size: 0.92rem; color: var(--gray-3); }
      .flujo { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1.6rem; font-size: 0.86rem; color: var(--gray-3); }
      .flujo span { padding: 0.35rem 0.85rem; background: #fff; border-radius: 99px; color: var(--gray-2); }
      .flujo i { font-style: normal; color: var(--gray-4); }

      /* blog interactivo */
      .secciones { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr)); gap: 1.1rem; }
      .seccion { min-width: 0; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--gray-5); border-radius: 1rem;
        padding: 1.4rem 1.4rem 1.2rem; transition: border-color 0.15s, box-shadow 0.15s; }
      .seccion:hover { border-color: #cdd5e1; box-shadow: var(--sombra); }
      .seccion header { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.7rem; }
      .seccion .i { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center; background: var(--accent-low); color: var(--accent); }
      .seccion h3 { margin: 0; font-size: 1.02rem; line-height: 1.25; }
      .seccion h3 a:hover { color: var(--accent) !important; }
      .seccion .cuantas { font-size: 0.76rem; color: var(--gray-3); }
      .seccion > p { margin: 0 0 0.9rem; font-size: 0.88rem; color: var(--gray-3); }
      .seccion ul { list-style: none; margin: auto 0 0; padding: 0.8rem 0 0; border-top: 1px solid var(--gray-5); display: grid; gap: 0.35rem; }
      .seccion li a { display: block; font-size: 0.88rem; color: var(--gray-2); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .seccion li a::before { content: '›  '; color: var(--accent); font-weight: 700; }
      .seccion li a:hover { color: var(--accent); }

      /* llamada final: banda azul */
      .final { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem 2.5rem; align-items: center; padding: 2.8rem;
        border-radius: 1.5rem; background: var(--accent); color: #dbe5ff; }
      @media (max-width: 760px) { .final { grid-template-columns: 1fr; padding: 1.8rem; } }
      .final .etiqueta { color: #fff; opacity: 0.8; }
      .final h2 { margin-top: 0.4rem; color: #fff; }
      .final p { margin: 0; max-width: 40rem; }
      .final .grandes { justify-content: flex-end; }
      @media (max-width: 760px) { .final .grandes { justify-content: flex-start; } }
      .final .gran.alta { background: #fff; color: var(--accent); box-shadow: none; }
      .final .gran.alta:hover { background: #edf2fe; }
      .final .gran.prueba-b { box-shadow: none; }
      .final .contacto-linea { margin-top: 0.9rem; font-size: 0.92rem; }
      .final .contacto-linea a { color: #fff; font-weight: 600; text-decoration: none; }
      .final .contacto-linea a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <TopNav />

    <main>
      <div class="ini-hero">
        <div class="wrap">
          <div>
            <div class="etiqueta">Plataforma <span class="gratis">gratuita</span> para comunidades energéticas</div>
            <h1>Crea y gestiona tu comunidad energética.</h1>
            <p class="lead">Socios, instalaciones, reparto de la energía y seguimiento en una sola plataforma, con un panel para cada socio. Y un blog con herramientas para calcular, documentar y tramitar cada paso.</p>
            <div class="grandes">
              <a class="gran alta" href={PORTAL_URL + ALTA_RUTA} data-plataforma="Alta de una comunidad energética" data-plataforma-ruta={ALTA_RUTA}>
                <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M19 8v6M16 11h6"/></svg>
                <span><b>Crear mi comunidad</b><small>Alta gratuita · lista del IDAE</small></span>
              </a>
              <a class="gran prueba-b" href={PORTAL_URL + PRUEBA_RUTA} data-plataforma="Comunidad de prueba" data-plataforma-ruta={PRUEBA_RUTA}>
                <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7.5 15h9"/></svg>
                <span><b>Probar la plataforma</b><small>Comunidad de prueba · {PRUEBA_VIDA} </small></span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <section class="apps" style="padding: 0;">
        <div class="wrap">
          <div class="apps-tit">
            <h2>La energía se entiende mejor experimentando.</h2>
            <a class="btn relleno" href="/blog/"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14Z"/><path d="M8 7h8M8 11h6"/></svg><span><b>Blog interactivo</b><small>Personalízalo y genera un PDF</small></span></a>
          </div>
          <ul>
            {apps.map((a) => (
              <li>
                <a class="app" href={doc(a.url)}>
                  <img src={a.img} alt={`Captura de la herramienta: ${a.t}`} width="1280" height="745" loading="lazy" decoding="async" />
                  <div><b>{a.t}</b><span>{a.d}</span></div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="plataforma">
        <div class="wrap">
          <div class="cabecera">
            <div>
              <div class="etiqueta">La plataforma</div>
              <h2>Todo lo que necesita una comunidad energética.</h2>
              <p class="intro">Del medidor en el cuadro de cada socio al panel de la comunidad, con las lecturas guardadas y sumadas en la nube.</p>
            </div>
            <a class="btn" href={PORTAL_URL} data-plataforma="Acceso socios">Acceso socios →</a>
          </div>
          <div class="plat">
            {plataforma.map((p, i) => (
              <div><span class="n">0{i + 1}</span><h3>{p.t}</h3><p>{p.d}</p></div>
            ))}
          </div>
          <div class="flujo" aria-label="Cómo llegan los datos">
            <span>Medidor por punto</span><i>→</i><span>Pasarela del socio</span><i>→</i><span>Envío cifrado</span><i>→</i><span>Plataforma en la nube</span><i>→</i><span>Paneles</span>
          </div>
        </div>
      </section>

      <section id="blog">
        <div class="wrap">
          <div class="cabecera">
            <div>
              <div class="etiqueta">Blog interactivo</div>
              <h2>{herramientas} herramientas para la energía, explicadas y calculadas.</h2>
              <p class="intro">Calculadoras, simuladores, informes y presupuestos que funcionan en el navegador, escritos por un ingeniero.</p>
            </div>
            <a class="btn" href="/blog/">Ver todo el blog →</a>
          </div>
          <div class="secciones">
            {blog.map((s) => (
              <article class="seccion">
                <header>
                  <div class="i"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONOS[s.ico]} /></div>
                  <div><h3><a href={s.url} style="color: inherit; text-decoration: none;">{s.t}</a></h3><span class="cuantas">{s.n} {s.n === 1 ? 'herramienta' : 'herramientas'}</span></div>
                </header>
                <p>{s.d}</p>
                <ul>{s.primeros.map((f) => <li><a href={doc(f.url)} title={f.title}>{f.title}</a></li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contacto" style="padding-top: 0;">
        <div class="wrap">
          <div class="final">
            <div>
              <div class="etiqueta">¿Empezamos?</div>
              <h2>Pon en marcha tu comunidad energética.</h2>
              <p>El uso de la plataforma es <strong class="gratis-f">gratuito</strong>: sin cuotas, sin permanencia y sin datos bancarios. Si lo prefieres, te ayudamos con la constitución, los medidores y el reparto.</p>
              <p class="contacto-linea"><a href="tel:+34951733491">951 733 491</a> · <a href="mailto:info@vatiaco.es">info@vatiaco.es</a></p>
            </div>
            <div class="grandes">
            <a class="gran alta" href={PORTAL_URL + ALTA_RUTA} data-plataforma="Alta de una comunidad energética" data-plataforma-ruta={ALTA_RUTA}>
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M19 8v6M16 11h6"/></svg>
              <span><b>Crear mi comunidad</b><small>Alta gratuita · lista del IDAE</small></span>
            </a>
            <a class="gran prueba-b" href={PORTAL_URL + PRUEBA_RUTA} data-plataforma="Comunidad de prueba" data-plataforma-ruta={PRUEBA_RUTA}>
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7.5 15h9"/></svg>
              <span><b>Probar la plataforma</b><small>Comunidad de prueba · {PRUEBA_VIDA} gratis</small></span>
            </a>
          </div>
          </div>
        </div>
      </section>
    </main>

    <PieSitio />
  </body>
</html>
