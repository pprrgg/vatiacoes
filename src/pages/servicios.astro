---
import TopNav from '../components/TopNav.astro';
import PieSitio from '../components/PieSitio.astro';
import '../styles/sitio.css';
// Servicios de VatiaCo: gestion de comunidades energeticas y plataforma de gestion, con los
// paquetes de la cuota por socio. La tarifa es la misma que cobra la API en el alta online
// (iot-thingsboard.sh, app/alta.py): escalonada, cada socio paga el precio de su tramo.
const PORTAL_URL = 'https://VatiaCo.duckdns.org/';
const B = '/docs/A00_Blog_Interactivo/';
const doc = (ruta: string) => `/blog/?doc=${encodeURIComponent(B + ruta)}`;

const TRAMOS = [   // centimos por socio y mes
  { desde: 1, hasta: 50, centimos: 99 },
  { desde: 51, hasta: 250, centimos: 89 },
  { desde: 251, hasta: 1000, centimos: 79 },
  { desde: 1001, hasta: 3000, centimos: 69 },
];
const MESES_ANUAL = 10;   // la cuota anual cobra 10 meses: 2 gratis
const cuota = (n: number) => TRAMOS.reduce((s, t) => s + Math.max(0, Math.min(n, t.hasta) - (t.desde - 1)) * t.centimos, 0);
const euros = (c: number) => (c / 100).toLocaleString('es-ES', { style: 'currency', currency: 'EUR',
  minimumFractionDigits: c % 100 ? 2 : 0, maximumFractionDigits: 2 });
const paquetes = [5, 20, 50, 100, 250, 1000].map((n) => ({
  n, mes: cuota(n), anio: cuota(n) * MESES_ANUAL,
  porSocio: (cuota(n) / n / 100).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
}));

const servicios = [
  {
    id: 'gestion', num: '01', icono: 'gestion',
    titulo: 'Gestión de comunidades energéticas',
    lema: 'Constitución, socios y reparto de la energía.',
    puntos: [
      'Constitución de la comunidad: forma jurídica, estatutos y registro.',
      'Alta de los socios con sus suministros (CUPS) y autorización de acceso a sus datos de Datadis.',
      'Acuerdos de reparto: cálculo y revisión de los coeficientes a partir del consumo real hora a hora.',
      'Gobernanza: convocatorias, actas de asamblea, reglamento interno y libro de socios.',
    ],
    enlaces: [
      { t: 'Constitución de comunidades', href: doc('A02_Comunidades Energéticas/C01_Comunidades_Energeticas.html') },
      { t: 'Presupuesto de puntos de medida', href: doc('A02_Comunidades Energéticas/C02_Presupuesto_Puntos_de_Medida.html') },
    ],
  },
  {
    id: 'plataforma', num: '02', icono: 'plataforma',
    titulo: 'Plataforma de gestión',
    lema: 'Un panel para cada socio y otro para la comunidad.',
    puntos: [
      'Descarga diaria y automática de las lecturas de Datadis de todos los suministros.',
      'Panel de cada socio: su consumo, su parte de la generación y su posición en el mapa.',
      'Panel del gestor: socios, reparto, informes PDF y Excel, documentos y copias de seguridad.',
      'Alta online en unos minutos: la plataforma de la comunidad se crea al pagar la suscripción.',
    ],
    enlaces: [
      { t: 'Mapa de comunidades', href: '/comunidades/' },
    ],
  },
];

const pasos = [
  { t: 'Alta online', d: 'Datos de la comunidad y del gestor, y número de socios' },
  { t: 'Primer mes gratis', d: 'La plataforma se crea al momento; no se cobra nada durante la prueba' },
  { t: 'Socios', d: 'El gestor da de alta a los socios con su CUPS' },
  { t: 'Datos', d: 'Cada noche llegan las lecturas de Datadis y se calcula el reparto' },
  { t: 'Seguimiento', d: 'Informes, documentos y asambleas desde la propia plataforma' },
];
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Servicios · VatiaCo</title>
    <meta name="description" content="Gestión de comunidades energéticas y plataforma de gestión por menos de 1 € por socio y mes. Primer mes gratis y sin permanencia." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
    <style is:global>
      .enlaces { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--gray-5); }
      .enlaces a { font-size: 0.85rem; font-weight: 600; color: var(--accent-high); text-decoration: none; padding: 0.3rem 0.65rem;
        border: 1px solid var(--gray-5); border-radius: 0.45rem; }
      .enlaces a:hover { border-color: var(--accent); background: var(--accent-low); }
      .pilar .btn.alta { margin-top: 1rem; }

      /* reclamos: menos de 1 euro por socio y primer mes gratis */
      .reclamos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-bottom: 2rem; }
      @media (max-width: 900px) { .reclamos { grid-template-columns: 1fr; } }
      .reclamo { display: flex; align-items: center; gap: 1.1rem; padding: 1.3rem 1.5rem; border-radius: 0.9rem;
        border: 1px solid var(--gray-5); background: linear-gradient(135deg, var(--accent-low), var(--gray-6)); }
      .reclamo .grande { font-size: clamp(2.2rem, 5vw, 3rem); font-weight: 800; line-height: 1; color: var(--bolt); letter-spacing: -0.03em; white-space: nowrap; }
      .reclamo .grande small { font-size: 0.45em; font-weight: 600; color: var(--gray-2); letter-spacing: 0; }
      .reclamo strong { display: block; color: var(--white); font-size: 1.05rem; }
      .reclamo p { margin: 0.2rem 0 0; font-size: 0.9rem; }

      /* paquetes */
      .paquetes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
      @media (max-width: 900px) { .paquetes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 520px) { .paquetes { grid-template-columns: 1fr; } }
      .paquete { position: relative; background: var(--gray-6); border: 1px solid var(--gray-5); border-radius: 0.9rem; padding: 1.4rem 1.4rem 1.2rem;
        display: flex; flex-direction: column; }
      .paquete .socios { font-size: 0.85rem; font-weight: 600; color: var(--gray-3); text-transform: uppercase; letter-spacing: 0.08em; }
      .paquete .socios b { font-size: 1.5rem; color: var(--white); letter-spacing: -0.01em; text-transform: none; }
      .paquete .precio { font-size: 2.3rem; font-weight: 800; color: var(--white); letter-spacing: -0.02em; margin: 0.6rem 0 0; line-height: 1.1; }
      .paquete .precio small { font-size: 0.95rem; font-weight: 500; color: var(--gray-3); letter-spacing: 0; }
      .paquete .unitario { display: inline-block; align-self: flex-start; margin: 0.6rem 0 0; padding: 0.2rem 0.6rem; border-radius: 0.4rem;
        background: rgba(255, 213, 79, 0.12); color: var(--bolt); font-weight: 700; font-size: 0.9rem; }
      .paquete ul { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.35rem; font-size: 0.88rem; flex: 1; }
      .paquete li { padding-left: 1.3rem; position: relative; }
      .paquete li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-high); font-weight: 700; }
      .paquete .btn { margin-top: 1.1rem; justify-content: center; }
      .tramos { margin-top: 2rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
      @media (max-width: 800px) { .tramos { grid-template-columns: 1fr; } }
      .tramos table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      .tramos th, .tramos td { padding: 0.55rem 0.4rem; border-bottom: 1px solid var(--gray-5); text-align: left; }
      .tramos th { color: var(--gray-3); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .tramos td:last-child { text-align: right; color: var(--white); font-weight: 600; font-variant-numeric: tabular-nums; }
      .tramos p { margin: 0 0 0.7rem; font-size: 0.92rem; }
      .tramos p strong { color: var(--white); }
    </style>
  </head>
  <body>
    <TopNav />

    <main>
      <div class="hero">
        <div class="wrap">
          <div class="etiqueta">Servicios</div>
          <h1>Tu comunidad energética, gestionada <em>por menos de 1 € por socio</em>.</h1>
          <p>Una plataforma propia para tu comunidad: un panel para cada socio y otro para la gestión, con los datos de Datadis cada día.
            Pruébala <strong style="color: var(--white);">un mes gratis, sin permanencia</strong>,
            y quédate solo si te resulta útil.</p>
          <div class="acciones">
            <a class="btn principal" href="/alta/">Probar un mes gratis</a>
            <a class="btn" href="#paquetes">Ver precios</a>
          </div>
        </div>
      </div>

      <section id="servicios">
        <div class="wrap">
          <div class="etiqueta">Qué hacemos</div>
          <h2>Dos servicios para tu comunidad.</h2>
          <p class="intro">La gestión de la comunidad y la plataforma que la sostiene, con un mismo equipo.</p>
          <div class="pilares">
            {servicios.map((s) => (
              <article class="pilar" id={s.id}>
                <header>
                  <div class="ico" aria-hidden="true">
                    {s.icono === 'gestion' && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.5a3.2 3.2 0 0 1 0 6.2M18 14.5c1.8.8 3 2.7 3 4.9"/></svg>
                    )}
                    {s.icono === 'plataforma' && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M7 13l3-3 2 2 4-4"/></svg>
                    )}
                  </div>
                  <div>
                    <div class="num">{s.num}</div>
                    <h3>{s.titulo}</h3>
                  </div>
                </header>
                <p class="lema">{s.lema}</p>
                <ul>{s.puntos.map((t) => <li>{t}</li>)}</ul>
                <div class="enlaces">{s.enlaces.map((e) => <a href={e.href}>{e.t}</a>)}</div>
                <a class="btn principal alta" href="/alta/">
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5"/><path d="M19 8v6M16 11h6"/></svg>
                  Da de alta tu comunidad
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="paquetes" style="background: rgba(35, 38, 47, 0.35);">
        <div class="wrap">
          <div class="etiqueta">Precios</div>
          <h2>Pagas por socio, nunca más de 0,99 €.</h2>
          <p class="intro">Una cuota mensual por socio que baja a medida que la comunidad crece. El primer mes no se cobra nada y puedes darte de baja cuando quieras.</p>

          <div class="reclamos">
            <div class="reclamo">
              <div class="grande">&lt;1 €</div>
              <div><strong>Por socio y mes</strong><p>Ningún socio cuesta más de 0,99 €. A partir de 50 socios, menos.</p></div>
            </div>
            <div class="reclamo">
              <div class="grande">1<small> mes</small></div>
              <div><strong>Gratis para probar</strong><p>No se cobra nada durante el primer mes. Si no te convence, te das de baja antes.</p></div>
            </div>
            <div class="reclamo">
              <div class="grande">0<small> ataduras</small></div>
              <div><strong>Sin permanencia</strong><p>Ni contrato mínimo ni penalización. Te das de baja con un email.</p></div>
            </div>
          </div>

          <div class="paquetes">
            {paquetes.map((p) => (
              <article class="paquete">
                <div class="socios"><b>{p.n.toLocaleString('es-ES')}</b> socios</div>
                <div class="precio">{euros(p.mes)} <small>/ mes</small></div>
                <span class="unitario">{p.porSocio} € por socio</span>
                <ul>
                  <li>Primer mes gratis</li>
                  <li>Sin permanencia</li>
                  <li>Anual: {euros(p.anio)} (2 meses gratis)</li>
                  <li>Panel para cada socio y para el gestor</li>
                </ul>
                <a class="btn" href="/alta/">Probar un mes gratis</a>
              </article>
            ))}
          </div>

          <div class="tramos">
            <div>
              <p><strong>Cómo se calcula.</strong> Cada socio paga el precio de su tramo, como en el IRPF: los 50 primeros a 0,99 €, del 51 al
                250 a 0,89 €, y así. Por eso una comunidad de 100 socios paga 94 € al mes (0,94 € por socio) y no 99 €.</p>
              <p>La cuota se ajusta sola cuando das de alta socios nuevos. Pago con tarjeta o domiciliación SEPA. Precios sin IVA.
                Para más de 3.000 socios, <a href="#contacto">te preparamos una tarifa a medida</a>.</p>
            </div>
            <table>
              <thead><tr><th>Socios</th><th>€ por socio y mes</th></tr></thead>
              <tbody>
                {TRAMOS.map((t) => (
                  <tr><td>{t.desde === 1 ? `Hasta ${t.hasta}` : `${t.desde.toLocaleString('es-ES')} – ${t.hasta.toLocaleString('es-ES')}`}</td>
                    <td>{(t.centimos / 100).toLocaleString('es-ES', { minimumFractionDigits: 2 })} €</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="como-trabajamos">
        <div class="wrap">
          <div class="etiqueta">Cómo funciona</div>
          <h2>De la alta a los primeros datos.</h2>
          <p class="intro">Todo online y en el mismo día.</p>
          <div class="cadena">
            {pasos.map((p) => (
              <div class="paso"><h4>{p.t}</h4><p>{p.d}</p></div>
            ))}
          </div>
        </div>
      </section>

      <section id="contacto">
        <div class="wrap">
          <div class="etiqueta">Contacto</div>
          <h2>¿Dudas? Te ayudamos.</h2>
          <p class="intro" style="margin-bottom: 0;">Si estás constituyendo la comunidad, tienes más de 3.000 socios o prefieres que hagamos el alta por ti, cuéntanos cuántos socios y suministros tiene.</p>
          <div class="contacto">
            <a class="btn principal" href="tel:+34951733491">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V21a1 1 0 0 1-1 1C10.61 22 2 13.39 2 3a1 1 0 0 1 1-1h4.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.01l-2.21 2.21Z"/></svg>
              951 733 491
            </a>
            <a class="btn" href="mailto:info@vatiaco.es?subject=Comunidad%20energ%C3%A9tica">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
              info@vatiaco.es
            </a>
            <a class="btn" href={PORTAL_URL} data-plataforma="Acceso socios">Acceso socios</a>
          </div>
        </div>
      </section>
    </main>

    <PieSitio />
  </body>
</html>
